# ====== Newsletter service config ======

# Public URL used to build absolute links in emails (confirm/unsubscribe/view post)
PUBLIC_BASE_URL=http://localhost:8000

# --- Content / Git source ---
# Either a local path (e.g. ./content) or a remote git URL.
# When a webhook hits, the service will `git pull` (or clone on first run).
# If GIT_REPO_URL and CONTENT_DIR are the same path, content is used in place.
GIT_REPO_URL=./content
# Optional branch; leave blank to use the remote's default
GIT_BRANCH=
# Local directory to mirror content into
CONTENT_DIR=./content

# --- Webhook ---
# Shared secret configured in GitHub webhook settings
GITHUB_WEBHOOK_SECRET=change-me-please

# --- Email / SMTP ---
MAIL_FROM="Newsletter <newsletter@tokenoodle.com>"
MAIL_FROM_NAME=Newsletter

# Backend: "smtp" or "http"
MAIL_BACKEND=smtp

# SMTP settings (used when MAIL_BACKEND=smtp). ImprovMX works as a relay:
#   SMTP_HOST=improvmx.com  SMTP_PORT=2525  SMTP_USE_TLS=true
SMTP_HOST=improvmx.com
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_STARTTLS=true

# HTTP mail API settings (used when MAIL_BACKEND=http)
# Generic Mailgun-style: POST {MAIL_HTTP_URL} with form fields from, to, subject, html, text
# Set MAIL_HTTP_URL=https://api.mailgun.net/v3/{domain}/messages and MAIL_HTTP_TOKEN=api:...
MAIL_HTTP_URL=
MAIL_HTTP_TOKEN=
MAIL_HTTP_HEADER=Authorization
MAIL_HTTP_SCHEME=Bearer

# --- Tokens ---
# Secret used to sign confirmation / unsubscribe tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=please-change-this-to-a-random-string

# --- Admin ---
# Token required to access /admin and /admin/api/*.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable the admin area entirely.
ADMIN_TOKEN=

# --- Server ---
HOST=127.0.0.1
PORT=8000
